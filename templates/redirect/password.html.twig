{% extends 'redirect/_layout.html.twig' %}
{% block title %}{{ 'redirect.password.title'|trans }}{% endblock %}
{% block content %}
    <h2>{{ 'redirect.password.title'|trans }}</h2>
    <p>{{ 'redirect.password.text'|trans }}</p>
    {% if error %}
        <p class="errors" role="alert">{{ 'redirect.password.wrong'|trans }}</p>
    {% endif %}
    <form method="post" action="{{ action }}" class="stack">
        <input type="hidden" name="code" value="{{ code }}">
        <input type="hidden" name="expiry" value="{{ expiry }}">
        <input type="hidden" name="mac" value="{{ mac }}">
        <div class="field">
            <label for="unlock-password" class="label">{{ 'redirect.password.label'|trans }}</label>
            <input type="password" id="unlock-password" name="password" required autocomplete="off" autofocus>
        </div>
        <button type="submit" class="btn btn-primary btn-block">{{ 'redirect.password.submit'|trans }}</button>
    </form>
{% endblock %}
