    <svg class="icon{{ class ? ' ' ~ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{{ (paths[name] ?? paths.plugin)|raw }}</svg>
