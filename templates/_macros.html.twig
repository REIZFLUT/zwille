{% macro nav_item(url, label, icon, active = false) %}
    <a href="{{ url }}" class="nav-link{{ active ? ' active' }}"{% if active %} aria-current="page"{% endif %}>{{ _self.icon(icon) }}<span>{{ label }}</span></a>
{%- endmacro %}

{#
    items: list of {label, url}; the last item is the current page and is rendered without a link.
#}
{% macro breadcrumbs(items) %}
    <nav class="breadcrumbs" aria-label="{{ 'nav.breadcrumbs'|trans }}">
        <ol>
            {% for item in items %}
                <li>
                    {%- if loop.last or item.url is not defined or item.url is null -%}
                        <span{% if loop.last %} aria-current="page"{% endif %}>{{ item.label }}</span>
                    {%- else -%}
                        <a href="{{ item.url }}">{{ item.label }}</a>
                    {%- endif -%}
                </li>
            {% endfor %}
        </ol>
    </nav>
{%- endmacro %}
