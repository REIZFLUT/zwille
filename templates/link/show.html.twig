{% extends 'base.html.twig' %}

{% import '_macros.html.twig' as ui %}

{% block title %}{{ link.domain.displayName }}/{{ link.code }}{% endblock %}

{% block breadcrumbs %}
    {{ ui.breadcrumbs([
        {label: 'nav.links'|trans, url: path('app_links')},
        {label: link.domain.displayName ~ '/' ~ link.code},
    ]) }}
{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>{{ link.title ?? (link.domain.displayName ~ '/' ~ link.code) }}</h1>
            <p class="sub">
                {% set status = link_status(link) %}
                <span class="badge badge-{{ status == 'live' ? 'success' : (status == 'inactive' ? 'warning' : (status == 'scheduled' ? 'accent' : 'danger')) }}">{{ ('links.status.' ~ status)|trans }}</span>
                {% if not link.domain.active %}<span class="badge badge-danger">{{ 'domain.inactive'|trans }}</span>{% endif %}
            </p>
        </div>
        <div class="actions">
            <a class="btn" href="{{ path('app_link_export', {id: link.id, days: stats.period.days}) }}">{{ ui.icon('download') }}{{ 'links.export_csv'|trans }}</a>
            <a class="btn btn-primary" href="{{ path('app_link_edit', {id: link.id}) }}">{{ ui.icon('edit') }}{{ 'action.edit'|trans }}</a>
        </div>
    </div>

    <div class="layout-aside">
        <div class="stack">
            <div class="card">
                <label class="label muted small" for="short-url">{{ 'link.short_url'|trans }}</label>
                <div class="copy-field">
                    <input type="text" readonly value="{{ link.shortUrl }}" id="short-url" class="short-url-input">
                    <button type="button" class="btn btn-primary" data-copy-target="#short-url" data-copied-label="{{ 'action.copied'|trans }}">{{ ui.icon('copy') }}{{ 'action.copy'|trans }}</button>
                </div>
                <div class="share">
                    <span class="small muted">{{ 'link.share'|trans }}</span>
                    <a class="btn btn-sm" href="https://twitter.com/intent/tweet?url={{ link.shortUrl|url_encode }}" rel="noopener noreferrer" target="_blank">X</a>
                    <a class="btn btn-sm" href="https://www.linkedin.com/sharing/share-offsite/?url={{ link.shortUrl|url_encode }}" rel="noopener noreferrer" target="_blank">LinkedIn</a>
                    <a class="btn btn-sm" href="https://www.facebook.com/sharer/sharer.php?u={{ link.shortUrl|url_encode }}" rel="noopener noreferrer" target="_blank">Facebook</a>
                    <a class="btn btn-sm" href="mailto:?subject={{ 'link.share_subject'|trans|url_encode }}&body={{ link.shortUrl|url_encode }}">{{ 'link.share_email'|trans }}</a>
                </div>
            </div>

            {{ include('_partials/stats.html.twig', {stats: stats, periods: periods}) }}
        </div>

        <div class="aside-sticky">
            <div class="card" id="qr">
                <h2>{{ 'link.qr'|trans }}</h2>
                <div class="qr"><img src="{{ path('app_link_qr', {id: link.id, format: 'svg'}) }}" alt="{{ 'link.qr'|trans }}" width="180" height="180"></div>
                <div class="actions" id="qr-downloads">
                    <a class="btn btn-sm" href="{{ path('app_link_qr', {id: link.id, format: 'svg', download: 1}) }}">{{ ui.icon('download') }}SVG</a>
                    <a class="btn btn-sm" href="{{ path('app_link_qr', {id: link.id, format: 'png', download: 1}) }}">{{ ui.icon('download') }}PNG</a>
                </div>
            </div>
            <div class="card">
                <h2>{{ 'link.details'|trans }}</h2>
                <dl class="kv">
                    <dt>{{ 'link.target_url'|trans }}</dt>
                    <dd><a href="{{ link.targetUrl }}" rel="noopener noreferrer" target="_blank">{{ link.targetUrl }}</a></dd>
                    {% for localisation in link.localisations %}
                        <dt>{{ localisation.language|language_name(app.request.locale) }} <span class="badge">{{ localisation.language }}</span></dt>
                        <dd><a href="{{ localisation.targetUrl }}" rel="noopener noreferrer" target="_blank">{{ localisation.targetUrl }}</a></dd>
                    {% endfor %}
                    {% if link.tags|length > 0 %}
                        <dt>{{ 'link.tags'|trans }}</dt>
                        <dd>{% for tag in link.tags %}<a class="badge" href="{{ path('app_links', {tag: tag.id}) }}">{{ tag.name }}</a> {% endfor %}</dd>
                    {% endif %}
                    {% if link.notes %}
                        <dt>{{ 'link.notes'|trans }}</dt>
                        <dd>{{ link.notes|nl2br }}</dd>
                    {% endif %}
                    <dt>{{ 'link.redirect_type'|trans }}</dt>
                    <dd>{{ ('link.redirect.' ~ link.redirectType)|trans }}</dd>
                    <dt>{{ 'link.starts_at'|trans }}</dt>
                    <dd>{{ link.startsAt ? link.startsAt|local_datetime : '–' }}</dd>
                    <dt>{{ 'link.expires_at'|trans }}</dt>
                    <dd>{{ link.expiresAt ? link.expiresAt|local_datetime : '–' }}</dd>
                    <dt>{{ 'link.max_clicks'|trans }}</dt>
                    <dd>{{ link.maxClicks ? link.maxClicks|local_number : ('link.max_clicks_unlimited'|trans) }}</dd>
                    {% if link.fallbackUrl %}
                        <dt>{{ 'link.fallback_url'|trans }}</dt>
                        <dd><a href="{{ link.fallbackUrl }}" rel="noopener noreferrer" target="_blank">{{ link.fallbackUrl }}</a></dd>
                    {% endif %}
                    <dt>{{ 'links.col.owner'|trans }}</dt>
                    <dd>{{ link.owner.displayName }}</dd>
                    <dt>{{ 'links.col.created'|trans }}</dt>
                    <dd>{{ link.createdAt|local_datetime }}</dd>
                    <dt>{{ 'link.last_click'|trans }}</dt>
                    <dd>{{ link.lastClickAt ? link.lastClickAt|local_datetime : '–' }}</dd>
                    <dt>{{ 'link.total_clicks'|trans }}</dt>
                    <dd>{{ link.clickCount|local_number }}</dd>
                </dl>
            </div>
        </div>
    </div>
{% endblock %}
