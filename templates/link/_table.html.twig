{% macro th(label, key, sort, dir, query, class = '') %}
    {% set active = sort == key %}
    {% set default_dir = key in ['target', 'code'] ? 'asc' : 'desc' %}
    {% set next = active ? (dir == 'asc' ? 'desc' : 'asc') : default_dir %}
    {% set aria = active ? (dir == 'asc' ? 'ascending' : 'descending') : 'none' %}
    <th class="{{ class }}" aria-sort="{{ aria }}">
        <a class="sort-link{{ active ? ' active' }}"
           href="{{ path('app_links', query|merge({sort: key, dir: next})) }}"
           title="{{ ('link.sort_' ~ next)|trans }}">
            {{ label }}<span class="sort-arrow" aria-hidden="true">{{ active ? (dir == 'asc' ? '↑' : '↓') : '↕' }}</span>
        </a>
    </th>
{% endmacro %}

{% import _self as sortui %}
{% import '_macros.html.twig' as ui %}

{#
    `bulk` turns on the selection column and the clickable, whitelisted sort headers for the
    /links list. The dashboard includes this partial without it and keeps its compact layout.
#}
{% set bulk = bulk|default(false) %}
{% set sort = sort|default('created') %}
{% set dir = dir|default('desc') %}
{% set query = query|default({}) %}
{# Sort links keep the current filters; the default order needs no parameters. #}

{% if links|length == 0 %}
    <div class="empty">
        <p>{{ 'links.empty'|trans }}</p>
    </div>
{% else %}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    {% if bulk %}<th class="select-col"><input type="checkbox" data-check-all='input[form="bulk-form"][name="ids[]"]' aria-label="{{ 'bulk.select_all'|trans }}"></th>{% endif %}
                    {% if bulk %}{{ sortui.th('links.col.link'|trans, 'code', sort, dir, query) }}{% else %}<th>{{ 'links.col.link'|trans }}</th>{% endif %}
                    {% if bulk %}{{ sortui.th('links.col.target'|trans, 'target', sort, dir, query, 'hide-sm') }}{% endif %}
                    {% if show_owner %}<th class="hide-sm">{{ 'links.col.owner'|trans }}</th>{% endif %}
                    {% if bulk %}{{ sortui.th('links.col.clicks'|trans, 'clicks', sort, dir, query, 'num') }}{% else %}<th class="num">{{ 'links.col.clicks'|trans }}</th>{% endif %}
                    {% if bulk %}{{ sortui.th('links.col.last_click'|trans, 'last_click', sort, dir, query, 'hide-md') }}{% endif %}
                    {% if bulk %}{{ sortui.th('links.col.created'|trans, 'created', sort, dir, query, 'hide-sm') }}{% else %}<th class="hide-sm">{{ 'links.col.created'|trans }}</th>{% endif %}
                    <th><span class="sr-only">{{ 'links.col.actions'|trans }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for link in links %}
                    <tr>
                        {% if bulk %}<td class="select-col"><input type="checkbox" name="ids[]" value="{{ link.id }}" form="bulk-form" aria-label="{{ 'bulk.select_link'|trans({'%code%': link.domain.displayName ~ '/' ~ link.code}) }}"></td>{% endif %}
                        <td class="link-cell">
                            <a class="short" href="{{ path('app_link_show', {id: link.id}) }}">{{ link.domain.displayName }}/<wbr>{{ link.code }}</a>
                            {% if not bulk %}<span class="target truncate" title="{{ link.targetUrl }}">{{ link.title ?? link.targetUrl }}</span>{% endif %}
                            {% if not link.active %}<span class="badge badge-warning">{{ 'link.inactive'|trans }}</span>{% endif %}
                            {% if link.expired %}<span class="badge badge-danger">{{ 'link.expired'|trans }}</span>{% endif %}
                            {% if link.localisations|length > 0 %}<span class="badge">{{ link.localisations|map(l => l.language)|join(' · ') }}</span>{% endif %}
                            {% for tag in link.tags %}
                                {% if bulk %}
                                    <a class="badge" href="{{ path('app_links', query|merge({tag: tag.id})) }}">{{ tag.name }}</a>
                                {% else %}
                                    <span class="badge">{{ tag.name }}</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        {% if bulk %}<td class="hide-sm target-cell"><span class="truncate muted small" title="{{ link.targetUrl }}">{{ link.title ?? link.targetUrl }}</span>{% if link.title %}<span class="truncate muted small">{{ link.targetUrl }}</span>{% endif %}</td>{% endif %}
                        {% if show_owner %}<td class="hide-sm small nowrap">{{ link.owner.displayName }}</td>{% endif %}
                        <td class="num">{{ link.clickCount|number_format(0, ',', '.') }}</td>
                        {% if bulk %}<td class="hide-md small muted nowrap">{{ link.lastClickAt ? link.lastClickAt|date('d.m.Y H:i') : '–' }}</td>{% endif %}
                        <td class="hide-sm small muted nowrap">{{ link.createdAt|date('d.m.Y') }}</td>
                        <td class="nowrap">
                            <div class="row-actions">
                                <button type="button" class="btn btn-sm btn-ghost btn-icon" data-copy="{{ link.shortUrl }}" data-copied-label="✓" aria-label="{{ 'action.copy_link'|trans({'%link%': link.domain.displayName ~ '/' ~ link.code}) }}" title="{{ 'action.copy'|trans }}">{{ ui.icon('copy') }}</button>
                                <a class="btn btn-sm btn-ghost btn-icon hide-sm" href="{{ path('app_link_show', {id: link.id}) }}#qr" aria-label="{{ 'action.open_qr'|trans }}: {{ link.domain.displayName }}/{{ link.code }}" title="{{ 'action.open_qr'|trans }}">{{ ui.icon('qr') }}</a>
                                <a class="btn btn-sm btn-ghost btn-icon" href="{{ path('app_link_edit', {id: link.id}) }}" aria-label="{{ 'action.edit'|trans }}: {{ link.domain.displayName }}/{{ link.code }}" title="{{ 'action.edit'|trans }}">{{ ui.icon('edit') }}</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
