<!DOCTYPE html>
<html lang="{{ email.locale|default('de') }}">
<body style="margin:0;padding:24px;background:#f6f6f8;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;color:#1d1b22;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
        <tr><td align="center">
            <table role="presentation" width="520" cellspacing="0" cellpadding="0" style="max-width:520px;background:#ffffff;border:1px solid #e3e1e8;border-radius:10px;">
                <tr><td style="padding:28px;">
                    <h1 style="font-size:20px;margin:0 0 14px;">{{ ('mail.' ~ purpose ~ '.heading')|trans({'%title%': app_title()}) }}</h1>
                    <p style="margin:0 0 14px;line-height:1.55;">{{ 'mail.greeting'|trans({'%name%': user.displayName}) }}</p>
                    <p style="margin:0 0 20px;line-height:1.55;">{{ ('mail.' ~ purpose ~ '.text')|trans({'%title%': app_title(), '%email%': user.email}) }}</p>
                    <p style="margin:0 0 22px;">
                        {% set palette = accent_palette() %}<a href="{{ url }}" style="display:inline-block;background:{{ palette.accent }};color:{{ palette.ink }};text-decoration:none;padding:11px 20px;border-radius:8px;font-weight:600;">{{ ('mail.' ~ purpose ~ '.button')|trans }}</a>
                    </p>
                    <p style="margin:0 0 6px;font-size:13px;color:#6b6775;">{{ 'mail.valid_until'|trans({'%date%': expires_at|local_datetime}) }}</p>
                    <p style="margin:0;font-size:13px;color:#6b6775;word-break:break-all;">{{ url }}</p>
                </td></tr>
            </table>
            <p style="font-size:12px;color:#6b6775;margin:14px 0 0;">{{ 'mail.ignore'|trans }}</p>
        </td></tr>
    </table>
</body>
</html>
