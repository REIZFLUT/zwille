{#
    Expects: stats (StatsBuilder result), optional periods + route params for the period switch.
    Optional part: 'summary' (tiles + chart), 'breakdowns' (the breakdown cards) or both (default),
    so wide layouts can place the two parts in different columns.
#}
{% set part = part|default('all') %}
<div class="stack">
    {% if part in ['all', 'summary'] %}
    <div class="stats">
        <div class="stat"><div class="value">{{ stats.totals.clicks|local_number }}</div><div class="label">{{ 'stats.clicks'|trans }}</div></div>
        <div class="stat"><div class="value">{{ stats.totals.visitors|local_number }}</div><div class="label">{{ 'stats.visitors'|trans }}</div></div>
        <div class="stat"><div class="value">{{ stats.period.days }}</div><div class="label">{{ 'stats.days'|trans }}</div></div>
    </div>

    <div class="card">
        <div class="card-head">
            <h2>{{ 'stats.per_day'|trans }}</h2>
            {% if periods is defined %}
                <div class="segmented">
                    {% for days in periods %}
                        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({days: days})) }}" class="{{ stats.period.days == days ? 'active' }}">{{ 'stats.period_days'|trans({'%days%': days}) }}</a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        {{ bar_chart(stats.series, 'stats.per_day'|trans) }}
        <p class="small muted">{{ 'stats.chart_hint'|trans }}</p>
    </div>
    {% endif %}

    {% if part in ['all', 'breakdowns'] %}

    <div class="grid grid-3">
        {% for field, rows in stats.breakdowns %}
            <div class="card">
                <h3>{{ ('stats.breakdown.' ~ field)|trans }}</h3>
                {% if rows is empty %}
                    <p class="muted small">{{ 'stats.no_data'|trans }}</p>
                {% elseif field == 'countryCode' and rows|length == 1 and rows[0].value is null %}
                    <p class="muted small">{{ 'stats.no_countries'|trans }}</p>
                {% else %}
                    {% set max = rows|first.clicks %}
                    <ul class="breakdown">
                        {% for row in rows %}
                            <li>
                                <span class="truncate">
                                    {% if row.value is null %}<span class="muted">{{ (field == 'referrerHost' ? 'stats.direct' : 'stats.unknown')|trans }}</span>
                                    {% elseif field == 'countryCode' %}{{ row.value|country_name(app.request.locale) }}
                                    {% elseif field == 'language' %}{{ row.value|language_name(app.request.locale) }}
                                    {% elseif field == 'deviceType' %}{{ ('device.' ~ row.value)|trans }}
                                    {% else %}{{ row.value }}{% endif %}
                                </span>
                                <span class="count">{{ row.clicks|local_number }}</span>
                                <span class="bar w{{ max > 0 ? (row.clicks / max * 20)|round : 0 }}"></span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
