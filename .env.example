# Kopieren nach .env (.env ist git-ignoriert), dann Werte anpassen.
# Fuer Produktion APP_ENV=prod setzen und APP_SECRET auf 32+ zufaellige Zeichen
# (php -r "echo bin2hex(random_bytes(16));"). Keine echten Produktions-Geheimnisse
# in eine versionierte Datei schreiben - siehe docs/INSTALL.md.
#
# Die Anwendung laedt .env bzw. ersatzweise die git-ignorierte .env.local; echte
# Umgebungsvariablen haben Vorrang. Ohne .env muss APP_ENV als echte
# Umgebungsvariable gesetzt werden. .env.example wird nie automatisch geladen.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# Produktion: https://<admin-host>
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Datenbank waehlen. Ohne weitere Angaben laeuft die App auf SQLite im Projektverzeichnis.
#
# DB_CONNECTION: sqlite | mysql | mariadb   (mysql und mariadb sind Aliase auf denselben
# pdo_mysql-Treiber). Ein unbekannter Wert bricht den Start mit klarer Meldung ab.
# Eine gesetzte DATABASE_URL hat IMMER Vorrang - die DB_*-Variablen werden dann ignoriert
# und die beiden Schemata nie gemischt. Vorrang der Quellen:
# echte Umgebungsvariablen > .env.local > .env.
DB_CONNECTION=sqlite

# SQLite: Pfad zur Datei, relativ zum Projektverzeichnis oder absolut. Das Verzeichnis
# muss fuer den PHP-FPM-Nutzer beschreibbar sein (im WAL-Modus legt SQLite daneben -wal
# und -shm an). Ohne DB_DATABASE gilt var/data/eatmyshort.sqlite.
DB_DATABASE=var/data/eatmyshort.sqlite

# MariaDB/MySQL: Rautezeichen entfernen und Werte anpassen. Benutzername und Passwort
# duerfen Sonderzeichen enthalten (werden vor dem Bau der DSN URL-kodiert).
# DB_CONNECTION=mariadb
# DB_DATABASE=eatmyshort
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=eatmyshort
# DB_PASSWORD=
# Nur bei Verbindung ueber einen Unix-Socket - ersetzt dann Host und Port:
# DB_SOCKET=/var/run/mysqld/mysqld.sock
# DB_CHARSET=utf8mb4
# Optional: Serverversion festnageln, z. B. mariadb-11.4.0 oder 8.0.36. Ohne den Wert wird
# die Version beim Verbinden erkannt (funktioniert fuer SQLite wie MariaDB/MySQL).
# DB_SERVER_VERSION=

# Override: ist DATABASE_URL gesetzt, gewinnt sie gegen alle DB_*-Variablen. Bei SQLite ist
# %kernel.project_dir% als Platzhalter erlaubt. Nur eintragen, wenn die DSN von Hand
# gesetzt werden soll - sonst unkommentiert lassen.
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/eatmyshort.sqlite"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Produktion z. B.: smtp://user:passwort@smtp.firma.de:587
MAILER_DSN=null://null
###< symfony/mailer ###


###> eatmyshort ###
# Hostname(s) der Verwaltungsoberflaeche, kommagetrennt. Der erste ist der Haupt-Host
# (WebAuthn Relying Party ID, absolute Links in Mails). Alle anderen Hosts werden als
# Kurzlink-Domains behandelt.
# Produktion: z. B. links.firma.de
APP_ADMIN_HOSTS=localhost
# Absender fuer Einladungen und Passwort-Links
# Produktion: "Kurzlinks Firma <noreply@firma.de>"
MAILER_FROM="EatMyShort.Link <noreply@localhost>"
# Diese IPs/CIDRs duerfen /admin IMMER aufrufen (Schutz vor Aussperren), kommagetrennt.
ADMIN_IP_ALLOWLIST=
# Nur die IPs der eigenen Reverse-Proxys eintragen, z. B. 10.0.0.5,10.0.0.6. Leer = keine Proxys.
# Niemals REMOTE_ADDR eintragen: Dann glaubt die App jedem Client-Header, jeder kann
# X-Forwarded-For faelschen und die IP-Sperre von /admin aushebeln.
TRUSTED_PROXIES=
# Optional: Pfad zu einer GeoLite2-Country.mmdb fuer Laender in der Statistik
GEOIP_DATABASE_PATH=
# Zeitzone fuer Statistik (Klicks pro Tag) und Anzeige
APP_TIMEZONE=Europe/Berlin
# Klicks werden nach so vielen Tagen von app:clicks:prune geloescht (0 = nie)
CLICK_RETENTION_DAYS=730
# Audit-Log wird nach so vielen Tagen von app:audit:prune geloescht (0 = nie)
AUDIT_RETENTION_DAYS=365
###< eatmyshort ###
